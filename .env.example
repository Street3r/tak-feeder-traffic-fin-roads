# TAK server CoT stream (TLS)
COT_URL=ssl://takserver:8089
CLIENT_CERT=/data/cert.pem
CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=0

# TAK Server Mission API (required for mission sync - DataSync)
API_HOST=takserver
API_PORT=8443
MISSION_NAME=TrafficFinRoads
MISSION_GROUP=
MISSION_TOKEN=
MY_UID=roads.0001

# Digitraffic GeoJSON Simple JSON
DIGITRAFFIC_URL=https://tie.digitraffic.fi/api/traffic-message/v2/traffic-announcements
UPDATE_INTERVAL=60

# CoT (base type configurable, default a-n-G - add usericon via ICONSET_PATH when known)
COT_TYPE=a-n-G
COT_HOW=h-e
ICONSET_PATH=

# Health
HEALTH_FILE=/tmp/tak-feeder-healthy

# Debug
DEBUG=0

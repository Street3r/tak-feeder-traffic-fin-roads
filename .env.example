# TAK server
COT_URL=ssl://takserver:8089
CLIENT_CERT=/data/cert.pem
CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=0

# Digitraffic
DIGITRAFFIC_URL=https://tie.digitraffic.fi/api/traffic-message/v2/traffic-announcements
UPDATE_INTERVAL=60
COT_STALE=300

# CoT types
COT_TYPE_POINT=a-f-G-E-V-C
COT_TYPE_LINE=u-d-f
COT_HOW=h-e

# Debug
DEBUG=0

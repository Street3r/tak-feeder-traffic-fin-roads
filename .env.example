# ---------------------------------------------------------------- TAK server
# Mission API on API_HOST:8443 with the client certificate (no CoT stream).
# Old names CLIENT_CERT / CLIENT_KEY still work.
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
API_HOST=takserver
#MY_UID=roads.0001

# ---------------------------------------------------------------- Datasets
# traffic-announcements, roadworks, weight-restrictions, exempted-transports
DATASETS=traffic-announcements
# One mission per dataset. Groups (comma-separated) apply when a mission is
# created: a group sees the mission in Channels, e.g. CONSTRUCTION sees only
# road works and TRAFFIC sees everything.
MISSION_NAME=TrafficFinRoads
#MISSION_GROUP=TRAFFIC
#ROADWORKS_MISSION_NAME=TrafficFinRoadworks
#ROADWORKS_MISSION_GROUP=CONSTRUCTION,TRAFFIC
#WEIGHT_RESTRICTIONS_MISSION_NAME=TrafficFinWeightRestrictions
#WEIGHT_RESTRICTIONS_MISSION_GROUP=BRIDGES,TRAFFIC
#EXEMPTED_TRANSPORTS_MISSION_NAME=TrafficFinExemptedTransports
#EXEMPTED_TRANSPORTS_MISSION_GROUP=TRAFFIC
# Sent as the Digitraffic-User header (no personal data)
#DIGITRAFFIC_USER=tak-feeder-traffic-fin-roads

# ---------------------------------------------------------------- CoT
#COT_TYPE=a-n-G
#COT_TYPE_LINE=u-d-f
#COT_HOW=h-e
#ICONSET_PATH=6d781afb-89a6-4c07-b2b9-a89748b6a38f/Transport/caution.png

# ---------------------------------------------------------------- Timing
#UPDATE_INTERVAL=60
#RETRY_INTERVAL=300
#DEBUG=0
